<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>App1</RootNamespace>
    <ApplicationTitle>App1</ApplicationTitle>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Plugin.Avalonia.MVVMExpress" Version="$(AvaloniaMvvmExpressVersion)" />
    <PackageReference Include="Plugin.Avalonia.MVVMExpress.Dialogs" Version="$(AvaloniaMvvmExpressVersion)" />
    <PackageReference Include="Plugin.Avalonia.MVVMExpress.Navigation" Version="$(AvaloniaMvvmExpressVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App1.Core\App1.Core.csproj" />
  </ItemGroup>

</Project>
