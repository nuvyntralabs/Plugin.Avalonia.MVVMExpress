<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="App1.Pages.LoginPage">
  <StackPanel Margin="24" MaxWidth="360" Spacing="8">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Sign in" />
    <TextBlock Text="demo@mvvmexpress.dev / secret" />
    <TextBox Text="{Binding Email}" />
    <TextBox Watermark="Password" Text="{Binding Password}" />
    <Button Content="Sign in" Command="{Binding SignInCommand}" />
  </StackPanel>
</UserControl>
